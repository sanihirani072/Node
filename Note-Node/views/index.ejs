<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task File Generator</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-black text-white min-h-screen py-12 px-4 font-sans">
    
    <section class="max-w-3xl mx-auto flex flex-col items-center gap-8">
        
        <h1 class="text-4xl text-center font-bold tracking-tight">Task File Generator</h1>
        
        <form action="#" method="POST" class="w-full bg-zinc-900 p-6 rounded-xl border border-zinc-800 flex flex-col sm:flex-row gap-4 shadow-lg">
            <input 
                type="text" 
                name="title"
                class="flex-1 bg-zinc-800 py-3 px-4 text-white rounded-lg outline-none focus:ring-2 focus:ring-orange-500 border border-zinc-700 transition"
                placeholder="Task Title"
                required>
            <input 
                type="text" 
                name="task"
                class="flex-[2] bg-zinc-800 py-3 px-4 text-white rounded-lg outline-none focus:ring-2 focus:ring-orange-500 border border-zinc-700 transition"
                placeholder="Task description..."
                required>
            <input 
                type="submit" 
                value="Add Task"
                class="bg-orange-500 px-6 py-3 font-semibold rounded-lg active:bg-orange-600 hover:bg-orange-400 transition cursor-pointer text-white shadow-md">
        </form>

        <div class="w-full mt-8">
            <h2 class="text-xl font-semibold mb-4 text-zinc-300 border-b border-zinc-800 pb-2">Your Tasks</h2>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800 hover:border-orange-500/50 transition flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-orange-400 mb-2">Buy Groceries</h3>
                        <p class="text-zinc-400 text-sm leading-relaxed mb-4">
                            Milk, eggs, bread, and some fresh vegetables for the week.
                        </p>
                    </div>
                    <div class="flex justify-between items-center mt-4">
                        <a href="/task/1" class="text-sm font-medium text-white hover:text-orange-400 transition">View Details &rarr;</a>
                        <form action="/delete/1" method="POST" class="inline">
                            <button type="submit" class="text-zinc-500 hover:text-red-500 text-sm transition">Edit</button>
                        </form>
                        <form action="/delete/1" method="POST" class="inline">
                            <button type="submit" class="text-zinc-500 hover:text-red-500 text-sm transition">Update</button>
                        </form>
                        <form action="/delete/1" method="POST" class="inline">
                            <button type="submit" class="text-zinc-500 hover:text-red-500 text-sm transition">Delete</button>
                        </form>
                    </div>
                </div>

                <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800 hover:border-orange-500/50 transition flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-orange-400 mb-2">Finish Project Report</h3>
                        <p class="text-zinc-400 text-sm leading-relaxed mb-4">
                            Complete the final documentation and submit it to the client portal by Friday.
                        </p>
                    </div>
                    <div class="flex justify-between items-center mt-4">
                        <a href="/task/2" class="text-sm font-medium text-white hover:text-orange-400 transition">View Details &rarr;</a>
                        <form action="/delete/2" method="POST" class="inline">
                            <button type="submit" class="text-zinc-500 hover:text-red-500 text-sm transition">Edit</button>
                        </form>
                        <form action="/delete/2" method="POST" class="inline">
                            <button type="submit" class="text-zinc-500 hover:text-red-500 text-sm transition">Update</button>
                        </form>
                        <form action="/delete/2" method="POST" class="inline">
                            <button type="submit" class="text-zinc-500 hover:text-red-500 text-sm transition">Delete</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>

    </section>
</body>

</html>