<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Task File Generator | Professional</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
      animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .bg-mesh {
      background-color: #000000;
      background-image:
        radial-gradient(at 0% 0%, rgba(79, 70, 229, 0.06) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(6, 182, 212, 0.04) 0px, transparent 50%);
    }
  </style>
</head>

<body class="bg-mesh text-slate-200 min-h-screen antialiased font-sans overflow-x-hidden">

  <!-- TOP BORDER -->
  <div class="w-full h-[1px] bg-white/10"></div>

  <!-- MAIN -->
  <main class="min-h-screen flex flex-col items-center pt-10 px-4">

    <!-- TITLE -->
    <h1 class="text-4xl sm:text-5xl font-bold text-white text-center mb-8 animate-fade-in">
      Task File Generator
    </h1>

    <!-- FORM -->
    <section class="animate-fade-in w-full max-w-xs">
      <form action="/create" method="POST" class="space-y-3 flex flex-col items-center">

        <input
          name="title"
          type="text"
          placeholder="title"
          required
          class="w-full bg-zinc-600/80 border border-zinc-700 rounded-md px-4 py-3 text-white placeholder:text-zinc-300 outline-none focus:ring-2 focus:ring-orange-400"
        >

        <input
          name="task"
          type="text"
          placeholder="tasks..."
          required
          class="w-full bg-zinc-600/80 border border-zinc-700 rounded-md px-4 py-3 text-white placeholder:text-zinc-300 outline-none focus:ring-2 focus:ring-orange-400"
        >

        <button
          type="submit"
          class="w-full py-3 bg-orange-500 hover:bg-orange-600 rounded-md font-semibold text-white transition duration-300"
        >
          Add Task
        </button>
      </form>
    </section>

    <!-- FILE LIST -->
    <section class="animate-fade-in mt-14 w-full flex justify-center">
      <div class="w-full max-w-5xl flex flex-wrap justify-center gap-6">

        <!-- IF EMPTY -->
        <% if (files.length === 0) { %>
          <div class="w-[260px] bg-gradient-to-br from-slate-800 to-slate-900 border border-green-500 rounded-2xl shadow-lg px-6 py-6 text-center">
            <h3 class="text-2xl font-bold text-white mb-3">No File</h3>
            <p class="text-sm text-zinc-400">Create your first task file</p>
          </div>
        <% } %>

        <!-- LOOP FILES -->
        <% files.forEach(function(file) { %>

          <div class="w-[260px] bg-gradient-to-br from-slate-800 to-slate-900 border border-green-500 rounded-2xl shadow-lg px-6 py-6">

            <h3 class="text-2xl font-bold text-white text-center mb-6 break-words">
              <%= file %>
            </h3>

            <div class="flex items-center justify-between gap-3">
              <a href="/files/<%= file %>" class="text-blue-500 text-sm sm:text-base font-medium hover:underline whitespace-nowrap">
                Open File
              </a>

              <a href="/edit/<%= file %>" class="text-gray-400 text-sm sm:text-base font-medium hover:text-white transition whitespace-nowrap">
                Edit File Name
              </a>
            </div>

          </div>

        <% }) %>

      </div>
    </section>

  </main>

</body>
</html>