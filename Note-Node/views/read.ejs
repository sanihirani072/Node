<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Read Files</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-black text-white min-h-screen">

    <section class="w-full min-h-screen flex items-center justify-center px-6 py-10">
        
        <div class="w-full max-w-3xl bg-zinc-900 border border-zinc-700 rounded-2xl p-8 shadow-2xl">
            
            <!-- Heading -->
            <h1 class="text-4xl font-bold text-center mb-8 text-orange-400">
                Read Task File
            </h1>

            <!-- Task Title -->
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-white mb-2">
                    <%= title %>
                </h2>
                <div class="w-20 h-1 bg-orange-500 rounded"></div>
            </div>

            <!-- Task Details -->
            <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-6">
                <p class="text-zinc-300 leading-8 whitespace-pre-line text-lg">
                    <%= task %>
                </p>
            </div>

            <!-- Back Button -->
            <div class="mt-8 text-center">
                <a href="/" class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-xl transition duration-300">
                    ← Back to Home
                </a>
            </div>

        </div>

    </section>

</body>
</html>