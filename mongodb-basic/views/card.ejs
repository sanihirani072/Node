<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Card</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <section class="flex flex-wrap items-center justify-center p-10">
        <% if(data.length> 0 ) { %>

            <% data.map((val)=>{ %>

                <div class="w-full max-w-sm rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                    <div class="flex items-center space-x-4">
                        <img class="h-16 w-16 rounded-full object-cover ring-2 ring-gray-100" src="<%= val.image %>"
                            alt="fname" />

                        <div class="flex-1 min-width-0">
                            <h2 class="text-lg font-bold text-gray-900 truncate">
                                <%= val.fullname %>
                            </h2>
                            <p class="text-sm text-gray-500 font-medium">@ <%= val.username %>
                            </p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <p class="text-sm text-gray-600 truncate">
                            <%= val.email %>
                        </p>
                    </div>

                    <div class="mt-6 flex gap-3">
                        <a href="/edit/<%= val.id %>"
                            class="text-center flex-1 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors">
                            <button>
                                Edit
                            </button>
                        </a>
                        <a href="/delete/<%= val._id %>" class="flex-1 rounded-md border border-red-200 bg-white px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-50 transition-colors>
                    <button
                        ">
                            Delete
                            </button>
                        </a>
                    </div>
                </div>
                <% }) %>
                    <% }else { %>
                        <h1 class="text-3xl text-gray-400"> No Card Here. Go and create some cards</h1>
                        <% } %>
    </section>
    <a href="/" class="flex items-center justify-center">
        <button
            class="bg-blue-500 w-20 text-center text-2xl  border-none rounded-md active:scale-95 active:bg-blue-200">
            < Back</button>
    </a>
</body>

</html>