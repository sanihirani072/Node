<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile Page</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100 flex items-start justify-center min-h-screen pt-20">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl">
      
      <div class="flex justify-between items-center mb-8 pb-4 border-b">
        <span class="text-3xl font-bold text-indigo-600">BrandLogo</span>
        <a href="/logout" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded-lg transition duration-300">
          Logout
        </a>
      </div>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-8">
        <div class="w-32 h-32 flex-shrink-0">
          <img 
            src="https://tse1.mm.bing.net/th/id/OIP.seDdkSGTjoFbOuZoNFipiwHaHa?pid=Api&P=0&h=220"
            alt="Profile Image" 
            class="w-full h-full object-cover rounded-full border-4 border-indigo-100 shadow-sm"
          >
        </div>
        
        <div class="text-center sm:text-left mt-2">
          <h2 class="text-3xl font-bold text-gray-800 capitalize">demo</h2>
          <p class="text-gray-600 mt-1">demo@gmail.com</p>
        </div>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2">Your Posts</h3>
        
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 text-center text-gray-500">
          You haven't created any posts yet.
        </div>
      </div>

    </div>
  </body>
</html>